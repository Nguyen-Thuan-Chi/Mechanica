# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local release/QA output; concise reports and selected screenshots stay in docs/.
/docs/evidence/*
!/docs/evidence/README.md
/backups/
__pycache__/
*.tmp
*.temp
*.bak
*.apk
*.aab

# Local configuration and signing credentials (never publish).
**/local.properties
**/key.properties
**/*.keystore
**/*.jks
*.p12
*.pfx
*.pem
*.key
node_modules/
.firebase/
firebase-debug.log
firestore-debug.log
/firebase.local.json
**/*service-account*.json
.env
.env.*
!.env.example

# Reference-only third-party material; redistribution rights are unconfirmed.
/references/
/reference_workflow.txt
